# Copy to .env (or .env.local) and fill in what you need. Both are git-ignored.
# Shell environment variables take precedence over values in these files.

# --- Audio generation (pnpm audio) ------------------------------------------
# Google Cloud Text-to-Speech auth. Use ONE of:
#   1. An API key restricted to the Text-to-Speech API
GOOGLE_TTS_API_KEY=
#   2. A service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#   3. Neither: run `gcloud auth application-default login` instead.

# Voices (changing one regenerates that accent's clips)
# TTS_VOICE_GB=en-GB-Neural2-B
# TTS_VOICE_US=en-US-Neural2-D

# Speaking rate, 0.25 to 4.0 (changing it regenerates every clip)
# TTS_SPEAKING_RATE=0.8

# Set to 1 to let `pnpm build` continue when clips are missing or stale
# SKIP_AUDIO_CHECK=0

# --- Site -------------------------------------------------------------------
# Absolute base URL for canonical links, the sitemap, Open Graph, JSON-LD and llms.txt
# NEXT_PUBLIC_SITE_URL=https://example.com
